# ==============================================================================
# FlowPulse Environment Variables Configuration
# ==============================================================================

# General
PROJECT_NAME=FlowPulse
NODE_ENV=development
GLOBAL_PREFIX=api/v1

# Backend Configuration (apps/api)
BACKEND_PORT=3001
PORT=3001

# Frontend Configuration (apps/web)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Database Configuration (Prisma ORM)
# Local PostgreSQL (via Docker Compose):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowpulse?schema=public
# Remote Supabase PostgreSQL (Production / Remote):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowpulse?schema=public

# Docker Compose Local PostgreSQL Service Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flowpulse
POSTGRES_PORT=5432

# ==============================================================================
# Clerk Authentication Configuration
# ==============================================================================
# Frontend (apps/web)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Backend (apps/api)
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_JWT_KEY=placeholder_public_key_pem_or_jwk
FLOWPULSE_ADMIN_EMAILS=admin@flowpulse.io

WEB_ORIGIN=http://localhost:3000

# ==============================================================================
# OpenRouter AI Configuration (apps/api)
# ==============================================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=FlowPulse
OPENROUTER_TIMEOUT_MS=15000

# ==============================================================================
# OpenTelemetry Configuration (apps/api)
# ==============================================================================
OTEL_SERVICE_NAME=flowpulse-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development

# ==============================================================================
# Playwright E2E Testing Configuration
# ==============================================================================
E2E_CLERK_USER_EMAIL=
E2E_CLERK_USER_PASSWORD=

